#!/bin/sh

sleep 1
OUTPUT=$(xrandr | grep " connected" | awk '{print $1}')
# Use a fractional rate to break the LCD inversion sync
MODE="2560x1440_119.90"

if ! xrandr | grep -q "$MODE"; then
    # Dynamically calculate the modeline for 119.90Hz and extract the parameters
    MODELINE=$(cvt 2560 1440 119.90 | grep Modeline | cut -d' ' -f3-)

    # We use 'eval' or unquoted variable expansion to pass the parameters correctly to xrandr
    xrandr --newmode "$MODE" $MODELINE
    xrandr --addmode "$OUTPUT" "$MODE"
fi

xrandr --output "$OUTPUT" --mode "$MODE"
